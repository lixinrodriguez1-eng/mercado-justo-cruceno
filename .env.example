# Copia este archivo como ".env" y ajusta los valores.

# Conexión a MySQL: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
# En XAMPP el usuario es "root" y la contraseña está vacía por defecto.
DATABASE_URL="mysql://root:@localhost:3306/cafeteria_db"

# Contraseña para entrar al panel /admin
ADMIN_PASSWORD="cambia-esta-contraseña"

# Clave secreta para firmar la sesión del administrador (cadena larga y aleatoria)
AUTH_SECRET="genera-una-cadena-larga-y-aleatoria"
