# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el .env a GitHub.

# Conexión a MySQL: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
#  - Local (XAMPP): mysql://root:@localhost:3306/mercado_justo_db
#  - Nube (TiDB Cloud Starter): mysql://USUARIO:CLAVE@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/mercado_justo?sslaccept=strict
DATABASE_URL="mysql://root:@localhost:3306/mercado_justo_db"

# Clave secreta para firmar las sesiones (cadena larga y aleatoria, mínimo 16 caracteres)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="genera-una-cadena-larga-y-aleatoria"

# Contraseñas de las cuentas de prueba que crea el seed (npx prisma db seed)
SEED_ADMIN_PASSWORD="cambia-esta-contraseña-1"
SEED_EMPRENDEDOR_PASSWORD="cambia-esta-contraseña-2"
